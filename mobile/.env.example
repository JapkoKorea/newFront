GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
API_BASE_URL=http://127.0.0.1:5000
KAKAO_REDIRECT_URI=japkotaxi://auth/callback
# Kakao REST credentials/client secret must stay on backend env only.

# 결제 안내 (카드 결제 비활성 기간). --dart-define 으로 넘긴다.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
NAVER_STORE_URL=
# 카카오톡 채널 공개 ID (예: _abcdEF). 비어 있으면 문의 버튼이 나오지 않는다.
KAKAO_CHANNEL_ID=
KAKAO_CHANNEL_URL=
