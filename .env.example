# ------------------------------------------------------------------------
# 잽코 택시투어 환경변수 예시
#
# 사용법: cp .env.example .env 후 값을 채운다. .env 는 커밋 금지(.gitignore 처리됨).
# 프론트(Next.js)와 백엔드(FastAPI)가 같은 .env 를 읽는다.
# NEXT_PUBLIC_* 는 브라우저 번들에 그대로 노출되므로 비밀값을 넣지 말 것.
# ------------------------------------------------------------------------

# ========================================================================
# 운영 도메인: japkokorea.com
#
# 프런트와 API 를 같은 등록 도메인 아래 둔다. 그래야 쿠키가 same-site 로
# 취급되고, 나중에 리프레시 토큰을 httpOnly 쿠키에 둘 수 있다.
# 서로 다른 도메인이면 SameSite=None 이 강제되고 Safari 가 차단한다.
#
#   프런트   https://japkokorea.com          (Oracle 서버, docker compose)
#   API      https://api.japkokorea.com      (같은 서버)
#
# 배포 시 아래 값들을 이렇게 채운다. 절차는 DEPLOY.md 참고.
#
#   WEB_DOMAIN=japkokorea.com
#   API_DOMAIN=api.japkokorea.com
#   NEXT_PUBLIC_SITE_URL=https://japkokorea.com
#   NEXT_PUBLIC_API_BASE_URL=https://api.japkokorea.com
#   NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://japkokorea.com/login
#   KAKAO_REDIRECT_URI=https://japkokorea.com/login
#   MOBILE_KAKAO_REDIRECT_URI=https://api.japkokorea.com/api/auth/kakao/mobile/callback
#   CORS_ALLOW_ORIGINS=https://japkokorea.com
#   REFRESH_COOKIE_SECURE=true
#   REFRESH_COOKIE_DOMAIN=            (비워 둘 것 — 아래 설명 참고)
#   FRONTEND_BASE_URL=https://japkokorea.com
#   SITE_URL=https://japkokorea.com
#   SMTP_* / ADMIN_NOTIFY_EMAILS  (알림 메일 — 아래 참고)
#
# 카카오 개발자 콘솔의 Redirect URI 허용목록에도 위 두 개를 등록해야 한다.
# ========================================================================


# === 배포 도메인 (docker compose + Caddy 용) ===

# Caddy 가 이 도메인으로 TLS 인증서를 자동 발급한다.
# 로컬 시험 시에는 localhost / localhost:8443 으로 둔다.
WEB_DOMAIN=localhost
API_DOMAIN=localhost:8443


# === 프론트엔드 (브라우저 노출) ===

# 백엔드 API 주소. 로컬은 5000, 배포 시 공개 API 도메인.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# 사이트 정규 도메인. sitemap.xml 과 canonical 에 사용된다.
# 미지정 시 Vercel 배포 URL, 그것도 없으면 http://localhost:3000 으로 떨어진다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps 브라우저용 키. HTTP 리퍼러 제한을 걸 것.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# 카카오 JavaScript 앱 키 및 웹 로그인 리다이렉트 URI.
# 리다이렉트 URI 는 카카오 개발자콘솔에 등록된 값과 정확히 일치해야 한다.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/login


# === 백엔드: 데이터베이스 ===

# LINE/카카오 챗 백엔드(japko/Backend)와 공유하는 DB.
#
# 로컬 개발: 맥에 설치한 MySQL 에 붙는다(아래 기본값).
# 서버 배포: docker compose 안의 mysql 컨테이너를 쓴다. MYSQL_HOST/PORT 는
#   compose 가 덮어쓰므로 그대로 둬도 된다. 대신 아래 셋은 반드시 바꾼다.
#   - MYSQL_USER: root 이면 mysql 컨테이너가 뜨지 않는다. 예) japko
#   - MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD: 길고 서로 다른 임의 문자열
#   최초 기동 때 이 값으로 DB 와 계정이 만들어진다. 나중에 바꿔도 이미 만든
#   계정의 비밀번호는 바뀌지 않는다(그때는 DB 안에서 ALTER USER).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=japko_local
# 서버 배포 전용. mysql 컨테이너의 root 비밀번호(백업·복원 스크립트가 쓴다).
MYSQL_ROOT_PASSWORD=

# DB 백업 (scripts/backup-db.sh). 로컬 보관 기간(일)과 원격 사본 위치.
# 원격은 rclone 리모트 이름:경로. 비우면 서버 디스크에만 남는다 — 서버가
# 사라지면 같이 사라지므로 운영에서는 반드시 채울 것. 예) oci:japko-backups
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=


# === 백엔드: 인증 ===

# JWT 서명 키. 배포 시 반드시 충분히 긴 임의 문자열로 교체할 것.
JWT_SECRET_KEY=

# 액세스 토큰 수명(분). 짧게 두고 리프레시 토큰으로 이어 간다.
ACCESS_TOKEN_MINUTES=30

# 리프레시 토큰 수명(일). 이 기간 재방문이 없으면 다시 로그인해야 한다.
REFRESH_TOKEN_DAYS=30

# 리프레시 토큰이 없는 모바일 앱에만 쓰이는 장기 토큰 수명(시간).
JWT_EXPIRES_HOURS=24

# --- 리프레시 쿠키 ---
# 비워 두는 것이 정답이다. 그러면 쿠키를 심은 호스트(api.japkokorea.com)만
# 받는다. `.japkokorea.com` 처럼 적으면 모든 서브도메인이 이 쿠키를 받게 되어,
# 서브도메인 하나만 뚫려도 리프레시 토큰이 넘어간다. 프런트가 다른
# 서브도메인이어도 CORS(credentials 허용)로 이미 전달되므로 필요 없다.
REFRESH_COOKIE_DOMAIN=
# 기본값은 켜짐이다. 프런트 주소가 http:// 이면(로컬) 자동으로 꺼진다.
# 운영에서는 반드시 켜진 상태여야 한다.
REFRESH_COOKIE_SECURE=

# 회전 직후 유예(초). 응답 유실·다중 탭 대비. 짧을수록 안전하다.
REFRESH_ROTATION_GRACE_SECONDS=10

# 카카오 REST API 키와 웹 콜백 URI (NEXT_PUBLIC_KAKAO_REDIRECT_URI 와 동일하게 유지).
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/login

# 모바일 앱 로그인 경로. 앱 연동 전에는 기본값으로 두어도 무방하다.
# MOBILE_KAKAO_REDIRECT_URI 는 백엔드 공개 주소여야 한다(로컬 기본값은 8000 포트).
MOBILE_KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/mobile/callback
MOBILE_APP_REDIRECT_URI=japkotaxi://auth/callback
# 앱으로 돌려보낼 수 있는 주소 허용 목록(쉼표 구분). 비워 두면 위 값 하나만
# 허용한다. 목록 밖의 주소는 무시되고 기본값으로 되돌아간다 —
# state 는 공격자가 만들어 붙일 수 있는 값이라 검증 없이 쓰면 안 된다.
MOBILE_APP_REDIRECT_ALLOWLIST=



# === 백엔드: 알림 메일 ===

# 비워 두면 알림을 건너뛴다(경고 한 줄만 남고 예약은 정상 동작).
# Gmail 을 쓰려면 2단계 인증을 켠 뒤 "앱 비밀번호"를 발급해 SMTP_PASSWORD 에 넣는다.
# 계정 비밀번호로는 로그인되지 않는다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 보내는 주소. 비우면 SMTP_USER 를 쓴다.
SMTP_FROM=
SMTP_FROM_NAME=잽코 택시투어

# 새 예약·취소 요청·결제 확인 요청을 받을 운영자 주소(쉼표로 여러 명).
# 비어 있으면 운영자 알림이 나가지 않는다.
ADMIN_NOTIFY_EMAILS=

# === 백엔드: 결제 (토스페이먼츠) ===

# 없으면 결제 준비/승인 요청이 500 으로 실패한다.
# CLIENT 키는 결제창 호출용으로 브라우저에 전달되고, SECRET 키는 서버 전용이다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 투어 예약금 기본값(원). 코스별 값은 DB courses.deposit_krw 가 우선한다.
BASE_DEPOSIT_KRW=15000

# 당일/전일 예약 시 적용되는 예약금(원). 기본값보다 낮아지지는 않는다.
LAST_MINUTE_DEPOSIT_KRW=20000


# === 백엔드: 도메인 및 CORS ===

# 브라우저에서 API 를 호출할 프론트 주소. 콤마로 여러 개 지정 가능.
CORS_ALLOW_ORIGINS=http://localhost:3000

# 결제 성공/실패 후 돌아올 프론트 주소. 배포 시 반드시 실제 도메인으로 바꿀 것.
# (기본값이 http://localhost:5173 이라 미설정 시 결제 후 죽은 주소로 이동한다)
FRONTEND_BASE_URL=http://localhost:3000

# sitemap.xml / robots.txt 에 기록될 정규 도메인.
SITE_URL=http://localhost:3000


# === 백엔드: 지도 (선택) ===

# 서버사이드 Places 호출 전용 키. 미설정 시 NEXT_PUBLIC_GOOGLE_MAPS_KEY 로 폴백한다.
# 브라우저 키에 리퍼러 제한을 걸면 서버 호출이 막히므로, 배포 시에는 IP 제한을 건
# 별도 키를 여기에 지정할 것.
GOOGLE_MAPS_SERVER_KEY=

# 결제 안내 (카드 결제 비활성 기간)
# 계좌 정보가 비어 있으면 계좌이체 안내가 잠긴다.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_NAVER_STORE_URL=
# 카카오톡 채널. 관리자센터의 채널 URL 에서 _ 뒤 부분을 넣는다.
# 예: https://pf.kakao.com/_abcdEF 이면 _abcdEF
# 비어 있으면 사이트의 카카오 문의 버튼이 나오지 않는다(죽은 링크 방지).
NEXT_PUBLIC_KAKAO_CHANNEL_ID=
# 단축 URL 등 전체 주소를 직접 쓰고 싶을 때만. ID 보다 우선한다.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 네이버 커머스 API (스마트스토어 주문 자동 확인)
# 커머스 API 센터에서 애플리케이션을 등록하면 발급된다. 없으면 자동 확인이
# 꺼지고 운영자가 직접 확인하는 흐름만 남는다.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
