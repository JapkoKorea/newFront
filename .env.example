# ------------------------------------------------------------------------
# 잽코 택시투어 환경변수 예시
#
# 사용법: cp .env.example .env 후 값을 채운다. .env 는 커밋 금지(.gitignore 처리됨).
# 프론트(Next.js)와 백엔드(FastAPI)가 같은 .env 를 읽는다.
# NEXT_PUBLIC_* 는 브라우저 번들에 그대로 노출되므로 비밀값을 넣지 말 것.
# ------------------------------------------------------------------------

# === 배포 도메인 (docker compose + Caddy 용) ===

# Caddy 가 이 도메인으로 TLS 인증서를 자동 발급한다.
# 로컬 시험 시에는 localhost / localhost:8443 으로 둔다.
WEB_DOMAIN=localhost
API_DOMAIN=localhost:8443


# === 프론트엔드 (브라우저 노출) ===

# 백엔드 API 주소. 로컬은 5000, 배포 시 공개 API 도메인.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# 사이트 정규 도메인. sitemap.xml 과 canonical 에 사용된다.
# 미지정 시 Vercel 배포 URL, 그것도 없으면 http://localhost:3000 으로 떨어진다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps 브라우저용 키. HTTP 리퍼러 제한을 걸 것.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# 카카오 JavaScript 앱 키 및 웹 로그인 리다이렉트 URI.
# 리다이렉트 URI 는 카카오 개발자콘솔에 등록된 값과 정확히 일치해야 한다.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/login


# === 백엔드: 데이터베이스 ===

# LINE/카카오 챗 백엔드(japko/Backend)와 공유하는 DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=japko_local


# === 백엔드: 인증 ===

# JWT 서명 키. 배포 시 반드시 충분히 긴 임의 문자열로 교체할 것.
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=24

# 카카오 REST API 키와 웹 콜백 URI (NEXT_PUBLIC_KAKAO_REDIRECT_URI 와 동일하게 유지).
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/login

# 모바일 앱 로그인 경로. 앱 연동 전에는 기본값으로 두어도 무방하다.
# MOBILE_KAKAO_REDIRECT_URI 는 백엔드 공개 주소여야 한다(로컬 기본값은 8000 포트).
MOBILE_KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/mobile/callback
MOBILE_APP_REDIRECT_URI=japkotaxi://auth/callback


# === 백엔드: 결제 (토스페이먼츠) ===

# 없으면 결제 준비/승인 요청이 500 으로 실패한다.
# CLIENT 키는 결제창 호출용으로 브라우저에 전달되고, SECRET 키는 서버 전용이다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 투어 예약금 기본값(원). 코스별 값은 DB courses.deposit_krw 가 우선한다.
BASE_DEPOSIT_KRW=15000

# 당일/전일 예약 시 적용되는 예약금(원). 기본값보다 낮아지지는 않는다.
LAST_MINUTE_DEPOSIT_KRW=20000


# === 백엔드: 도메인 및 CORS ===

# 브라우저에서 API 를 호출할 프론트 주소. 콤마로 여러 개 지정 가능.
CORS_ALLOW_ORIGINS=http://localhost:3000

# 결제 성공/실패 후 돌아올 프론트 주소. 배포 시 반드시 실제 도메인으로 바꿀 것.
# (기본값이 http://localhost:5173 이라 미설정 시 결제 후 죽은 주소로 이동한다)
FRONTEND_BASE_URL=http://localhost:3000

# sitemap.xml / robots.txt 에 기록될 정규 도메인.
SITE_URL=http://localhost:3000


# === 백엔드: 지도 (선택) ===

# 서버사이드 Places 호출 전용 키. 미설정 시 NEXT_PUBLIC_GOOGLE_MAPS_KEY 로 폴백한다.
# 브라우저 키에 리퍼러 제한을 걸면 서버 호출이 막히므로, 배포 시에는 IP 제한을 건
# 별도 키를 여기에 지정할 것.
GOOGLE_MAPS_SERVER_KEY=
